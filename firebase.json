{
  "hosting": [
    {
      "site": "portafolio-franco-cuniberti",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/_astro/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/videos/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/portafolio-social-*.gif",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "site": "portafolio-fc",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://portafolio-franco-cuniberti.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://portafolio-franco-cuniberti.web.app/:path*",
          "type": 301
        }
      ]
    },
    {
      "site": "franco-cuniberti",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://portafolio-franco-cuniberti.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://portafolio-franco-cuniberti.web.app/:path*",
          "type": 301
        }
      ]
    }
  ]
}
