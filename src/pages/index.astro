---
import { siDiscord, siGmail, siInstagram, siWhatsapp } from 'simple-icons';
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import { contact, longVideos, profile, shortVideos } from '../data/portfolio';

const contacts = [
  { icon: siGmail, label: contact.email.label, href: contact.email.address && `mailto:${contact.email.address}` },
  { icon: siDiscord, label: contact.discord.label, href: contact.discord.url },
  { icon: siWhatsapp, label: contact.whatsapp.label, href: contact.whatsapp.url },
  { icon: siInstagram, label: contact.instagram.label, href: contact.instagram.url },
].filter((c) => c.href);

const year = new Date().getFullYear();
---

<Base
  title={`${profile.name} — Portafolio`}
  description={`Portafolio de ${profile.name}, ${profile.role.toLowerCase()}.`}
>
  <main>
    <!-- First screen: hero centered, "Proyectos" peeking in at the bottom -->
    <div class="intro">
    <header class="hero">
      <h1 class="hero-title">
        <span class="serif hero-serif" data-reveal>{profile.name}</span>
        <span class="wide hero-wide" data-reveal>{profile.role}</span>
      </h1>
      <p class="hero-meta serif" data-reveal>
        {
          profile.tags.map((tag, i) => (
            <>
              {i > 0 && <span class="dot" aria-hidden="true" />}
              <span>{tag}</span>
            </>
          ))
        }
      </p>
    </header>

    <a class="projects-cue" href="#proyectos" data-reveal>
      <svg class="chevrons" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 3l5 5 5-5"></path>
        <path d="M7 10l5 5 5-5"></path>
        <path d="M7 17l5 5 5-5"></path>
      </svg>
      <h2 class="serif section-serif">Proyectos</h2>
      <svg class="chevrons" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 3l5 5 5-5"></path>
        <path d="M7 10l5 5 5-5"></path>
        <path d="M7 17l5 5 5-5"></path>
      </svg>
    </a>
    </div>

    <!-- Projects -->
    <section class="projects" id="proyectos" aria-label="Proyectos">
      <div class="section-head" data-reveal>
        <h3 class="wide section-wide">Videos cortos</h3>
      </div>
      <div class="grid grid-short">
        {shortVideos.map((video) => <VideoCard video={video} ratio="vertical" />)}
      </div>

      <div class="section-head section-head-long" data-reveal>
        <h3 class="wide section-wide">Videos largos</h3>
      </div>
      <div class="grid grid-long">
        {longVideos.map((video) => <VideoCard video={video} ratio="horizontal" />)}
      </div>
    </section>

    <!-- Contact -->
    <footer class="contact" id="contacto">
      <h2 class="serif contact-serif" data-reveal>Contacto</h2>
      <p class="wide contact-wide" data-reveal>¿Hacemos algo juntos?</p>

      <ul class="contact-buttons" data-reveal>
        {
          contacts.map((c) => (
            <li>
              <a
                class="contact-button"
                href={c.href}
                target={c.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                aria-label={c.icon.title}
                title={c.label}
              >
                <span class="contact-circle">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d={c.icon.path} />
                  </svg>
                </span>
                <span class="wide contact-label">{c.icon.title}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="contact-small">© {year} {profile.name}</p>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* First screen: exactly one viewport tall, "Proyectos" sits fully visible at the bottom. */
  .intro {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8vh 0 4vh;
  }
  /* Shrink-wrapped to arrows + word, so hover only triggers from the arrows inward. */
  .projects-cue {
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 48px);
    margin-bottom: clamp(36px, 7vh, 72px); /* outside the hover area */
    text-decoration: none;
  }
  /* Underline that draws in from the left on hover, so "Proyectos" reads as a button. */
  .projects-cue .section-serif {
    position: relative;
    padding-bottom: 0.12em;
  }
  .projects-cue .section-serif::after {
    content: '';
    position: absolute;
    left: 0.04em;
    right: 0.04em;
    bottom: 0;
    height: clamp(2px, 0.22vw, 4px);
    border-radius: 999px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .projects-cue:hover .section-serif::after,
  .projects-cue:focus-visible .section-serif::after {
    transform: scaleX(1);
  }
  .projects-cue:focus-visible {
    outline: none;
  }
  .projects-cue .chevrons {
    width: clamp(30px, 3.2vw, 52px);
    height: clamp(30px, 3.2vw, 52px);
    margin-top: 0.4em;
  }
  .hero-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-serif {
    font-size: clamp(56px, 11vw, 164px);
    white-space: nowrap;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.02em;
  }
  .hero-wide {
    font-size: clamp(24px, 5.6vw, 78px);
    margin-top: -0.08em;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35em 0.9em;
    margin: 0.9em 0 0;
    font-size: clamp(18px, 2.2vw, 28px);
    line-height: 1;
  }
  .dot {
    width: 0.3em;
    height: 0.3em;
    border-radius: 50%;
    background: currentColor;
  }

  /* Projects */
  .projects {
    padding-bottom: 12vh;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 48px;
  }
  .projects {
    padding-top: 9vh;
    scroll-margin-top: 0;
  }
  .section-head-long {
    margin-top: 12vh;
  }
  .section-serif {
    margin: 0;
    display: inline-flex;
    align-items: flex-start;
    font-size: clamp(72px, 12vw, 168px);
  }
  .section-wide {
    margin: 0;
    font-size: clamp(22px, 3.6vw, 48px);
  }
  .chevrons {
    width: clamp(24px, 2.4vw, 36px);
    height: clamp(24px, 2.4vw, 36px);
    flex: none;
  }
  /* Triple chevron lighting up top to bottom, like a cascade. */
  .chevrons path {
    animation: cascade 1.2s ease-in-out infinite;
  }
  .chevrons path:nth-child(2) {
    animation-delay: 0.2s;
  }
  .chevrons path:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes cascade {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chevrons path {
      animation: none;
    }
  }
  .grid {
    display: grid;
    gap: clamp(12px, 2vw, 28px);
  }
  .grid-short {
    grid-template-columns: repeat(3, 1fr);
    row-gap: clamp(36px, 6vw, 84px);
  }
  /* Only two long videos: side by side, breaking out wider than the text column. */
  .grid-long {
    --long-width: min(1300px, calc(100vw - 3 * var(--gutter)));
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2.4vw, 36px);
    width: var(--long-width);
    margin-left: calc((100% - var(--long-width)) / 2);
  }

  /* Contact */
  .contact {
    text-align: center;
    padding: 4vh 0 6vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .contact-serif {
    margin: 0;
    display: inline-flex;
    align-items: flex-start;
    font-size: clamp(72px, 12vw, 168px);
  }
  .contact-wide {
    margin: 0;
    font-size: clamp(18px, 2.6vw, 34px);
  }
  .contact-buttons {
    list-style: none;
    margin: clamp(48px, 8vh, 80px) 0 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(24px, 5vw, 72px);
  }
  .contact-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-decoration: none;
  }
  .contact-circle {
    display: grid;
    place-items: center;
    width: clamp(92px, 11vw, 150px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid currentColor;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .contact-circle svg {
    width: 42%;
    height: 42%;
  }
  .contact-label {
    font-size: clamp(11px, 1vw, 14px);
  }
  .contact-button:hover .contact-circle,
  .contact-button:focus-visible .contact-circle {
    background: var(--accent);
    color: var(--paper);
    transform: translateY(-6px) scale(1.04);
  }
  .contact-button:focus-visible {
    outline: none;
  }
  .contact-small {
    margin: 12vh 0 0;
    font-size: 13px;
    opacity: 0.8;
  }

  @media (max-width: 760px) {
    .hero-serif {
      font-size: 14.5vw;
    }
    .hero-wide {
      font-size: 7vw;
    }
    .grid-short {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-long {
      grid-template-columns: 1fr;
    }
  }
</style>
