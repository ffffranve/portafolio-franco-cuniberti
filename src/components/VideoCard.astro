---
import type { Video } from '../data/portfolio';

interface Props {
  video: Video;
  ratio: 'vertical' | 'horizontal';
}

const { video, ratio } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class={`card ${ratio}`} data-reveal>
  <div class="frame">
    {
      video.kind === 'youtube' && (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0&modestbranding=1`}
          title={video.title}
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
        />
      )
    }
    {
      video.kind === 'file' && (
        <video
          src={`${base}/${video.src.replace(/^\//, '')}`}
          poster={video.poster ? `${base}/${video.poster.replace(/^\//, '')}` : undefined}
          playsinline
          preload="metadata"
          controls
          controlslist="nodownload"
          data-portfolio-video
          aria-label={video.title}
        />
      )
    }
    {
      video.kind === 'placeholder' && (
        <div class="placeholder">
          <span class="wide">{video.title}</span>
        </div>
      )
    }
  </div>
</figure>

<style>
  /* Subtle red rounded border hugging the video's edges. */
  .card {
    margin: 0;
    position: relative;
    overflow: hidden;
    border: 2px solid rgb(var(--accent-rgb) / 0.55);
    border-radius: 16px;
    background: #000;
    background-clip: padding-box; /* keep the black out from under the translucent border */
    will-change: transform; /* own compositor layer: hover lift doesn't repaint the video */
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.3s ease,
      box-shadow 0.35s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Hover (and the video that's playing): a hotter, more saturated red than the site accent,
     so the selected video really pops. */
  .card:hover,
  .card:focus-within,
  .card.is-playing {
    --hot: 255 18 8;
    border-color: rgb(var(--hot));
    box-shadow:
      0 0 0 3px rgb(var(--hot) / 0.3),
      0 0 24px 3px rgb(var(--hot) / 0.6),
      0 14px 34px -12px rgb(var(--hot) / 0.7);
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-within,
    .card.is-playing {
      transform: none;
    }
  }
  .frame {
    position: relative;
  }
  .vertical .frame {
    aspect-ratio: 9 / 16;
  }
  .horizontal .frame {
    aspect-ratio: 16 / 9;
  }
  iframe,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    display: block;
    background: #000;
  }
  /* Fullscreen: show the whole frame, never cropped or stretched. */
  video:fullscreen {
    position: static;
    width: 100vw;
    height: 100vh;
    object-fit: contain;
    border-radius: 0;
  }
  /* Video area reacts on press (see Base.astro), so show it's clickable. */
  video {
    cursor: pointer;
    touch-action: manipulation;
  }

  /* Loading ring while the browser waits for data. */
  .card.is-buffering::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    border: 3px solid rgb(228 228 225 / 0.3);
    border-top-color: var(--paper);
    animation: spin 0.7s linear infinite;
    pointer-events: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 12px;
    text-align: center;
    font-size: clamp(10px, 1.1vw, 13px);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      rgb(var(--accent-rgb) / 0.06) 14px 15px
    );
  }
</style>
