---
import type { Video } from '../data/portfolio';

interface Props {
  video: Video;
  ratio: 'vertical' | 'horizontal';
}

const { video, ratio } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class={`card ${ratio}`} data-reveal>
  <div class="frame">
    {
      video.kind === 'youtube' && (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0&modestbranding=1`}
          title={video.title}
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
        />
      )
    }
    {
      video.kind === 'file' && (
        <>
          <video
            src={`${base}/${video.src.replace(/^\//, '')}`}
            poster={video.poster ? `${base}/${video.poster.replace(/^\//, '')}` : undefined}
            playsinline
            preload="metadata"
            controlslist="nodownload"
            data-portfolio-video
            aria-label={video.title}
          />
          <button class="play-overlay" type="button" aria-label={`Reproducir ${video.title}`}>
            <span class="play-button">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5Z" />
              </svg>
            </span>
          </button>
        </>
      )
    }
    {
      video.kind === 'placeholder' && (
        <div class="placeholder">
          <span class="wide">{video.title}</span>
        </div>
      )
    }
  </div>
</figure>

<style>
  /* Subtle blue rounded border hugging the video's edges. */
  .card {
    margin: 0;
    position: relative;
    overflow: hidden;
    border: 2px solid rgb(20 80 255 / 0.55);
    border-radius: 16px;
    background: #000;
    background-clip: padding-box; /* keep the black out from under the translucent border */
    will-change: transform; /* own compositor layer: hover lift doesn't repaint the video */
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.3s ease,
      box-shadow 0.35s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Hover (and the video that's playing): solid border, blue glow and a small lift. */
  .card:hover,
  .card:focus-within,
  .card.is-playing {
    border-color: var(--blue);
    box-shadow:
      0 0 0 3px rgb(20 80 255 / 0.18),
      0 0 22px 2px rgb(20 80 255 / 0.45),
      0 14px 34px -12px rgb(20 80 255 / 0.55);
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-within,
    .card.is-playing {
      transform: none;
    }
  }
  .frame {
    position: relative;
  }
  .vertical .frame {
    aspect-ratio: 9 / 16;
  }
  .horizontal .frame {
    aspect-ratio: 16 / 9;
  }
  iframe,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    display: block;
    background: #000;
  }
  /* Fullscreen: show the whole frame, never cropped or stretched. */
  video:fullscreen {
    position: static;
    width: 100vw;
    height: 100vh;
    object-fit: contain;
    border-radius: 0;
  }
  /* Big play button shown until the first play; it vanishes on press, not on release. */
  .play-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: opacity 0.12s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  /* Subtle glassy play mark: barely there until you hover the video. */
  .play-button {
    display: grid;
    place-items: center;
    width: clamp(38px, 3.6vw, 46px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: rgb(255 255 255 / 0.9);
    opacity: 0.7;
    transition:
      opacity 0.2s ease,
      transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      background 0.2s ease;
  }
  .play-button svg {
    width: 40%;
    height: 40%;
    margin-left: 8%;
  }
  .card:hover .play-button,
  .play-overlay:focus-visible .play-button {
    opacity: 1;
    background: rgb(255 255 255 / 0.2);
    transform: scale(1.06);
  }
  .play-overlay:active .play-button {
    transform: scale(0.94);
  }
  .play-overlay:focus-visible {
    outline: none;
  }
  .card.is-started .play-overlay {
    opacity: 0;
    pointer-events: none;
  }

  /* Loading ring while the browser waits for data. */
  .card.is-buffering::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    border: 3px solid rgb(228 228 225 / 0.3);
    border-top-color: var(--paper);
    animation: spin 0.7s linear infinite;
    pointer-events: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 12px;
    text-align: center;
    font-size: clamp(10px, 1.1vw, 13px);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      rgb(20 80 255 / 0.06) 14px 15px
    );
  }
</style>
