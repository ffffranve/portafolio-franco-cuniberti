---
import '../styles/global.css';
// Same files global.css loads: preloading them lets the text paint in its real fonts from the start.
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import wideFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f4f2ee" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
    {
      [serifFont, wideFont, bodyFont].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <script is:inline>
      document.documentElement.classList.add('js');
      // Keep the page hidden until the fonts are ready, so it never flashes in a fallback font.
      // The 2 s cap means a slow connection still shows the page.
      document.documentElement.classList.add('fonts-loading');
      Promise.race([
        Promise.all([
          document.fonts.load('italic 400 1em "Instrument Serif"'),
          document.fonts.load('800 1em "Archivo Variable"'),
          document.fonts.load('400 1em "Inter Variable"'),
        ]).catch(() => {}),
        new Promise((r) => setTimeout(r, 2000)),
      ]).then(() => document.documentElement.classList.remove('fonts-loading'));
      // Always open at the top (the name), never at a remembered position or a #section link.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Start at the top on every load (covers browsers that jump after the head script ran).
      window.scrollTo({ top: 0, behavior: 'instant' });

      // In-page links (Proyectos, etc.) scroll smoothly without adding #section to the URL,
      // so reloading or sharing the link never opens halfway down the page.
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.querySelector(link.getAttribute('href') ?? '');
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Fade sections in as they scroll into view.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      // Videos play only on click, always with sound, and one at a time.
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-portfolio-video]');

      // Buffer videos as they get close to the screen, so pressing play starts right away.
      const preloader = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              (entry.target as HTMLVideoElement).preload = 'auto';
              preloader.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '400px 0px' },
      );

      // Height of the native control bar: presses there are left to the browser.
      const CONTROLS_ZONE = 56;

      videos.forEach((video) => {
        const card = video.closest('.card');
        preloader.observe(video);

        // Toggle on press (pointerdown), not on release: it fires ~100 ms earlier than the
        // browser's own click-to-play, so starting and resuming feel instant.
        let handledPress = false;
        video.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          const rect = video.getBoundingClientRect();
          if (event.clientY > rect.bottom - CONTROLS_ZONE) return;
          handledPress = true;
          if (video.paused || video.ended) {
            video.muted = false;
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
        // Cancel the browser's own toggle for that same press, or it would undo ours.
        video.addEventListener('click', (event) => {
          if (handledPress) {
            event.preventDefault();
            handledPress = false;
          }
        });

        video.addEventListener('play', () => {
          video.muted = false;
          if (video.volume === 0) video.volume = 1;
          videos.forEach((other) => {
            if (other !== video) other.pause();
          });
          card?.classList.add('is-playing');
        });
        video.addEventListener('pause', () => card?.classList.remove('is-playing', 'is-buffering'));
        video.addEventListener('ended', () => card?.classList.remove('is-playing', 'is-buffering'));
        video.addEventListener('waiting', () => card?.classList.add('is-buffering'));
        video.addEventListener('playing', () => card?.classList.remove('is-buffering'));
      });
    </script>
  </body>
</html>
