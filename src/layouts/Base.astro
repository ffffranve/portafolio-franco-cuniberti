---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#e4e4e1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Fade sections in as they scroll into view.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      // Videos play only on click, always with sound, and one at a time.
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-portfolio-video]');

      // Buffer videos as they get close to the screen, so pressing play starts right away.
      const preloader = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              (entry.target as HTMLVideoElement).preload = 'auto';
              preloader.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '400px 0px' },
      );

      videos.forEach((video) => {
        const card = video.closest('.card');
        const overlay = card?.querySelector<HTMLButtonElement>('.play-overlay');
        preloader.observe(video);

        const start = () => {
          if (card?.classList.contains('is-started')) return;
          card?.classList.add('is-started'); // instant visual feedback
          video.controls = true;
          video.muted = false;
          void video.play().catch(() => {
            // Playback refused (rare): bring the button back.
            card?.classList.remove('is-started');
            video.controls = false;
          });
        };
        // pointerdown fires on press, ~100 ms before click; click still covers the keyboard.
        overlay?.addEventListener('pointerdown', (event) => {
          if (event.button === 0) start();
        });
        overlay?.addEventListener('click', start);

        video.addEventListener('play', () => {
          card?.classList.add('is-started');
          video.controls = true;
          video.muted = false;
          if (video.volume === 0) video.volume = 1;
          videos.forEach((other) => {
            if (other !== video) other.pause();
          });
          card?.classList.add('is-playing');
        });
        video.addEventListener('pause', () => card?.classList.remove('is-playing', 'is-buffering'));
        video.addEventListener('ended', () => card?.classList.remove('is-playing', 'is-buffering'));
        video.addEventListener('waiting', () => card?.classList.add('is-buffering'));
        video.addEventListener('playing', () => card?.classList.remove('is-buffering'));
      });
    </script>
  </body>
</html>
