---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f4f2ee" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Fade sections in as they scroll into view.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

      // Videos play only on click, always with sound, and one at a time.
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-portfolio-video]');

      // Buffer videos as they get close to the screen, so pressing play starts right away.
      const preloader = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              (entry.target as HTMLVideoElement).preload = 'auto';
              preloader.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '400px 0px' },
      );

      // Height of the native control bar: presses there are left to the browser.
      const CONTROLS_ZONE = 56;

      videos.forEach((video) => {
        const card = video.closest('.card');
        preloader.observe(video);

        // Toggle on press (pointerdown), not on release: it fires ~100 ms earlier than the
        // browser's own click-to-play, so starting and resuming feel instant.
        let handledPress = false;
        video.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          const rect = video.getBoundingClientRect();
          if (event.clientY > rect.bottom - CONTROLS_ZONE) return;
          handledPress = true;
          if (video.paused || video.ended) {
            video.muted = false;
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
        // Cancel the browser's own toggle for that same press, or it would undo ours.
        video.addEventListener('click', (event) => {
          if (handledPress) {
            event.preventDefault();
            handledPress = false;
          }
        });

        video.addEventListener('play', () => {
          video.muted = false;
          if (video.volume === 0) video.volume = 1;
          videos.forEach((other) => {
            if (other !== video) other.pause();
          });
          card?.classList.add('is-playing');
        });
        video.addEventListener('pause', () => card?.classList.remove('is-playing', 'is-buffering'));
        video.addEventListener('ended', () => card?.classList.remove('is-playing', 'is-buffering'));
        video.addEventListener('waiting', () => card?.classList.add('is-buffering'));
        video.addEventListener('playing', () => card?.classList.remove('is-buffering'));
      });
    </script>
  </body>
</html>
